# ---- Ollama (100% local)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:14b
JUDGE_MODEL=qwen2.5:14b
EMBEDDING_MODEL=bge-m3
LLM_NUM_CTX=16384
LLM_TEMPERATURE=0.0

# ---- Qdrant: server (Docker) OR embedded file mode (leave QDRANT_URL empty)
QDRANT_URL=http://localhost:6333
# QDRANT_PATH=./data/qdrant_local
QDRANT_COLLECTION=eu_legal_corpus
# QDRANT_API_KEY=

# ---- Retrieval / reranking: flashrank | cross_encoder | none
RERANKER_BACKEND=flashrank
RERANKER_MODEL=ms-marco-MultiBERT-L-12
CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=6

# ---- Agents
MAX_RETHINK_ITERATIONS=2

# ---- Ragas evaluation
RAGAS_MIN_FAITHFULNESS=0.70
RAGAS_MIN_CONTEXT_RELEVANCE=0.60
RAGAS_MIN_ANSWER_RELEVANCY=0.60
RAGAS_MAX_SAMPLES=20

LOG_LEVEL=INFO
