# Configuration locale - EU AI Compliance Auditor

# ---- Ollama (installe sur Windows)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:14b
JUDGE_MODEL=qwen2.5:14b
EMBEDDING_MODEL=bge-m3
LLM_NUM_CTX=16384
LLM_TEMPERATURE=0.0

# ---- Qdrant en mode local, sans Docker (QDRANT_URL doit rester vide)
QDRANT_URL=
QDRANT_PATH=./data/qdrant_local
QDRANT_COLLECTION=eu_legal_corpus

# ---- Reranker
RERANKER_BACKEND=flashrank
RERANK_TOP_N=6

# ---- Agents
MAX_RETHINK_ITERATIONS=2
LLM_MAX_RETRIES=2

# ---- Evaluation Ragas
RAGAS_MIN_FAITHFULNESS=0.70
RAGAS_MIN_CONTEXT_RELEVANCE=0.60
RAGAS_MIN_ANSWER_RELEVANCY=0.60
RAGAS_MAX_SAMPLES=20

LOG_LEVEL=INFO